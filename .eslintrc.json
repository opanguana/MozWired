{
  "extends": ["next/core-web-vitals", "next", "plugin:@typescript-eslint/recommended"],
  "plugins": ["@typescript-eslint"],
  "rules": {
    "semi": ["error", "always"],
    "quotes": ["error", "single"],
    "@typescript-eslint/no-unused-vars": ["warn", {"args": "none"}],
    "@typescript-eslint/explicit-module-boundary-types": "off"
  }
}
